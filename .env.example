# พอร์ตสำหรับเข้าใช้งานผ่าน Web Browser (ค่าเริ่มต้น: 8000)
PORT=8000

# การเชื่อมต่อไปยัง PostgreSQL Database
# รูปแบบ: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/it_service

# URL สำหรับ IT Ticket Notifier (ถ้ามี)
IT_SERVICE_URL=http://localhost:8000
